{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "yfmd main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "opener:default",
    "core:path:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    { "identifier": "fs:scope", "allow": [{ "path": "**" }, { "path": "/**" }] }
  ]
}
